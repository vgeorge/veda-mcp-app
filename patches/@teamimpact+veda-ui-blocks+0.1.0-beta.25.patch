Interim shim: titiler expects object-valued render params (colormap) as one JSON-encoded param; beta.25 serialized them with String() -> "[object Object]" -> 400. Fixed upstream in NASA-IMPACT/tinacms-portal-monorepo#558 (merged 2026-10-14, not in any release as of beta.25). Delete this patch when bumping to the first release that includes it.

diff --git a/node_modules/@teamimpact/veda-ui-blocks/dist/index.js b/node_modules/@teamimpact/veda-ui-blocks/dist/index.js
index d7fa435..40d60c3 100644
--- a/node_modules/@teamimpact/veda-ui-blocks/dist/index.js
+++ b/node_modules/@teamimpact/veda-ui-blocks/dist/index.js
@@ -5734,6 +5734,8 @@ var formatRenderPropertiesToQuery = (renderProperties) => {
     if (!isDefined(value)) return;
     if (isArray(value)) {
       value.map((v) => query.append(key, String(v)));
+    } else if (value !== null && typeof value === "object") {
+      query.append(key, JSON.stringify(value));
     } else {
       query.append(key, String(value));
     }
