{
  "name": "veda-mcp-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP App (Apps SDK) for interacting with a VEDA STAC catalog. Scaffold: wired hello-world tool + React UI resource.",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "bin": {
    "veda-mcp-app": "dist/server/main.js"
  },
  "scripts": {
    "build": "tsc --noEmit && npm run build:ui && npm run build:server",
    "build:ui": "cross-env INPUT=collection-picker.html vite build && cross-env INPUT=map.html vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "postinstall": "patch-package",
    "prepare": "npm run build",
    "watch": "cross-env INPUT=map.html vite build --watch",
    "serve": "tsx --watch server/main.ts",
    "serve:stdio": "tsx server/main.ts --stdio",
    "start": "npm run build && npm run serve",
    "start:prod": "node dist/server/main.js",
    "setup:claude": "node scripts/setup-claude.mjs",
    "test": "vitest run",
    "dev": "cross-env NODE_ENV=development concurrently \"npm run watch\" \"npm run serve\""
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@teamimpact/veda-ui-blocks": "0.1.0-beta.25",
    "cors": "^2.8.6",
    "events": "^3.3.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "cross-env": "^10.1.0",
    "patch-package": "^8.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  }
}
